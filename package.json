{
  "name": "alpinoxi-launcher",
  "version": "1.0.0",
  "description": "Alpinoxi Client — modern, high-performance Minecraft launcher with HUD, cosmetics, friends, party, Modrinth and MS/ely.by/offline login.",
  "main": "./out/main/index.js",
  "author": "alpstudios346",
  "license": "MIT",
  "homepage": "https://github.com/alpstudios346/alpinoxi-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/alpstudios346/alpinoxi-launcher.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "social": "node server/index.js",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
